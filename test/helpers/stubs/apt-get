#!/usr/bin/env bash
# Stub for apt-get. Logs "apt-get <args>" to $STUB_LOG, prints $STUB_APT_GET_OUT, exits with $STUB_APT_GET_EXIT (default 0).
echo "apt-get $*" >>"${STUB_LOG:-/dev/null}"
[ -n "${STUB_APT_GET_OUT:-}" ] && printf '%s\n' "${STUB_APT_GET_OUT}"
rc="${STUB_APT_GET_EXIT:-0}"
# Simulate a successful installation: place a ccache stub into $STUB_INSTALL_CCACHE_TO.
if [ "${rc}" -eq 0 ] && [ -n "${STUB_INSTALL_CCACHE_TO:-}" ]; then
  cp "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ccache" "${STUB_INSTALL_CCACHE_TO}/ccache"
fi
exit "${rc}"
